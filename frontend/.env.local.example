# Upstream FastAPI service. Server-only (never sent to the browser).
ANALYZER_URL=http://127.0.0.1:8080

# Shared secret between this proxy and the FastAPI backend. Set the same
# value as INTERNAL_TOKEN on Fly. When unset, the backend skips the check
# (local dev). In prod, set both sides so direct hits to the Fly URL 401.
# INTERNAL_TOKEN=
